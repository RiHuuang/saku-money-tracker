{
  "name": "saku-money-manager",
  "private": true,
  "version": "2.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node scripts/test.mjs",
    "android:publish": "node scripts/publish-android-release.mjs",
