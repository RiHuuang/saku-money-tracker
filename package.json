    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource/dm-sans": "^5.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "wrangler": "^4.147.0"
