<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/quick_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/quick_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_quick_title"
        android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/quick_actions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
        <Button android:id="@+id/quick_expense" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:background="@drawable/widget_action_background" android:text="@string/widget_quick_expense" android:textAllCaps="false" android:textColor="@color/widget_action_text" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/quick_income" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginTop="5dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_soft_background" android:text="@string/widget_quick_income" android:textAllCaps="false" android:textColor="@color/widget_teal" android:textSize="11sp" />
            <Button android:id="@+id/quick_transfer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginTop="5dp" android:background="@drawable/widget_soft_background" android:text="@string/widget_quick_transfer" android:textAllCaps="false" android:textColor="@color/widget_teal" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/quick_sign_in" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/widget_open_sign_in" android:textColor="@color/widget_muted" android:textSize="12sp" />
</LinearLayout>
